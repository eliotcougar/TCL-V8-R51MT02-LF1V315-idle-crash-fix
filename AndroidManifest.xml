<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.eliotcougar.tvidlefix" android:versionCode="2" android:versionName="0.2.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="TV Idle Fix" android:icon="@drawable/ic_stat_fix"
        android:allowBackup="false" android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true" android:supportsRtl="true">
        <!-- Privileged ADB start/stop remains possible without adding a UI or
             giving ordinary apps access to this component. -->
        <service android:name=".FixService" android:exported="true"
            android:permission="android.permission.DUMP" android:directBootAware="true"
            android:stopWithTask="false" />
        <receiver android:name=".BootReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
